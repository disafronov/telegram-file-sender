#
# telegram-file-sender environment variables
#
# Copy this file to .env and fill in the values, or pass them via
# `docker run --env-file` / Makefile docker-run targets.
#
# TELEGRAM_BOT_TOKEN: bot token from @BotFather
# TELEGRAM_CHAT_ID: chat or channel id to send the file to
# TELEGRAM_CHAT_MESSAGE: caption for the file (MarkdownV2)
# TELEGRAM_FILE_NAME: full path to the file to send
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_MESSAGE=
TELEGRAM_FILE_NAME=
